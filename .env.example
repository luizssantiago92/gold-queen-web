# Base URL of gold-queen-api. Local default:
VITE_API_BASE_URL=http://127.0.0.1:8000

# In production point it at the deployed API, e.g.
# VITE_API_BASE_URL=https://gold-queen-api.onrender.com

# Never put PLUGGY_CLIENT_SECRET or GEMINI_API_KEY here: anything prefixed with
# VITE_ is inlined into the bundle and therefore public. Those secrets live only
# in the backend.
